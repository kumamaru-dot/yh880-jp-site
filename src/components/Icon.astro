---
interface Props {
  name: string;
}

const { name } = Astro.props;

const paths: Record<string, string> = {
  'flame-off':
    '<path d="M12 3c3 3.8 5.2 6.6 5.2 9.2a5.2 5.2 0 0 1-10.4 0C6.8 9.6 9 6.8 12 3z"/><line x1="4" y1="20" x2="20" y2="4"/>',
  droplet: '<path d="M12 3c3 3.8 5.2 6.6 5.2 9.2a5.2 5.2 0 0 1-10.4 0C6.8 9.6 9 6.8 12 3z"/>',
  coins:
    '<ellipse cx="12" cy="6.5" rx="7" ry="3"/><path d="M5 6.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/><path d="M5 11.5v5c0 1.7 3.1 3 7 3s7-1.3 7-3v-5"/>',
  'shield-check':
    '<path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z"/><polyline points="9 12 11.5 14.5 15.5 10"/>',
  shield: '<path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z"/>',
  leaf:
    '<path d="M4 20c0-8 5-13 16-14 0 10-5 14-11 14a5 5 0 0 1-5-5z"/><line x1="4" y1="20" x2="14" y2="10"/>',
  thermometer:
    '<path d="M12 3a2.5 2.5 0 0 1 2.5 2.5v7.6a4.5 4.5 0 1 1-5 0V5.5A2.5 2.5 0 0 1 12 3z"/><line x1="12" y1="8" x2="12" y2="14"/>',
  repeat:
    '<polyline points="17 2 21 6 17 10"/><path d="M21 6H8a4 4 0 0 0-4 4v1"/><polyline points="7 22 3 18 7 14"/><path d="M3 18h13a4 4 0 0 0 4-4v-1"/>',
  layers:
    '<polygon points="12 3 21 8 12 13 3 8"/><polyline points="3 12.5 12 17.5 21 12.5"/><polyline points="3 16.5 12 21.5 21 16.5"/>',
};

const svgBody = paths[name] ?? paths.shield;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={svgBody}
/>
